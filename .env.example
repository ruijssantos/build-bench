# Copy to .env.local for local development. In Vercel, these are set as
# project environment variables instead — see docs/PLAN.md §9.2.

# Set automatically by the Neon integration when you connect it to the
# project in Vercel's Storage tab. Locally: pull it with `vercel env pull`,
# or paste your Neon connection string here.
DATABASE_URL=

# Set automatically by the Vercel Blob store once connected.
BLOB_READ_WRITE_TOKEN=

# 32 random bytes, base64-encoded — generate with: openssl rand -base64 32
# Signs the session cookie. Changing this logs everyone out.
AUTH_SECRET=

# Whatever you want to type to log in. Plain text on the server side only —
# never sent anywhere but compared against what you submit at /login.
APP_PASSPHRASE=

# Your own Anthropic API key, billed to your own account pay-as-you-go — no
# markup, no bundling. Needed from Phase 3 onwards: kit search on the
# Wishlist screen resolves a query through Claude with web search
# (docs/PLAN.md §5.1 stage A), roughly $0.02–0.05 per search. Get one at
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
